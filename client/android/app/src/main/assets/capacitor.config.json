{
	"appId": "com.ultra.whatsapp",
	"appName": "WhatsApp Ultra Pro",
	"webDir": "dist",
	"bundledWebRuntime": false,
	"server": {
		"androidScheme": "https",
		"cleartext": true
	},
	"android": {
		"allowMixedContent": true,
		"captureInput": true,
		"webContentsDebuggingEnabled": true
	},
	"plugins": {
		"LocalNotifications": {
			"smallIcon": "ic_stat_icon_config_sample",
			"iconColor": "#00A884"
		},
		"Camera": {
			"permissions": [
				"camera",
				"photos"
			]
		}
	}
}
